# Copy to .env.local. Never commit credentials. Use a staging Firebase project first.
APP_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative server auth: GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RESEND_FROM=
BOOKING_NOTIFICATION_TO=
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_TO=
WEBSITE_BOOKINGS_COLLECTION=bookings
CRON_SECRET=
# Only for isolated local integration testing, never production:
# FIREBASE_EMULATOR_MODE=true
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
